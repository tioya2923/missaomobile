{
  "expo": {
    "name": "L'Ombembwa",
    "slug": "missao-no-huambo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#181818"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.missaonohuambo.app"
    },
    "android": {
      "package": "org.missaonohuambo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#181818"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "A aplicação usa o Face ID para proteger o acesso ao seu perfil."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A aplicação precisa de acesso à galeria para escolher a sua foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8df64736-c42f-45cb-b1e7-1b00d1ce33f5"
      }
    }
  }
}
